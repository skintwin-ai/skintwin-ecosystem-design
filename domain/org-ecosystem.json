{
  "hub": {
    "org": "skintwin-ai",
    "name": "skintwin-ecosystem-design",
    "environmentName": "skintwin-ai org ecosystem",
    "install": "./scripts/cloud-agent-install.sh",
    "environmentKeys": ["name", "install", "repositoryDependencies"]
  },
  "policies": {
    "skipMissing": true,
    "frozenLockfiles": true,
    "hubOnlyFiles": true,
    "allowStart": false,
    "allowTerminals": false,
    "allowLiveSecrets": false,
    "allowSchemaKey": false,
    "allowGpuJuliaPhpDefaultInstall": false,
    "neverAddPnpmWorkspaceYamlTo": ["regima-platform"],
    "doNotFixPreexistingSiblingBugs": [
      "org-skin aggregator imports",
      "skintwinnector TypeScript assets",
      "skintwin-bot missing dist/entry.js"
    ]
  },
  "searchRoots": ["/agent/repos", "/workspace/repos", "/workspace"],
  "repos": [
    {
      "name": "SolutionSpaceKernel",
      "github": "github.com/skintwin-ai/SolutionSpaceKernel",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "mixed"
    },
    {
      "name": "Yggdrasil",
      "github": "github.com/skintwin-ai/Yggdrasil",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "julia"
    },
    {
      "name": "anycog",
      "github": "github.com/skintwin-ai/anycog",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "mixed"
    },
    {
      "name": "cognitive-architecture",
      "github": "github.com/skintwin-ai/cognitive-architecture",
      "role": "cpu-core",
      "installKind": "npm",
      "stack": "node",
      "installOrder": 4
    },
    {
      "name": "ecosystem-bridge",
      "github": "github.com/skintwin-ai/ecosystem-bridge",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "mixed"
    },
    {
      "name": "esm",
      "github": "github.com/skintwin-ai/esm",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "gpu"
    },
    {
      "name": "gnu_gneuralnetwork",
      "github": "github.com/skintwin-ai/gnu_gneuralnetwork",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "gpu"
    },
    {
      "name": "llm-foundry",
      "github": "github.com/skintwin-ai/llm-foundry",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "gpu"
    },
    {
      "name": "mini-swe-agent",
      "github": "github.com/skintwin-ai/mini-swe-agent",
      "role": "checkout-only",
      "installKind": "none",
      "stack": "python"
    },
    {
      "name": "multiskin",
      "github": "github.com/skintwin-ai/multiskin",
