      "installKind": "none",
      "stack": "gpu"
    },
    {
      "name": "neuro-symbolic-core",
      "github": "github.com/skintwin-ai/neuro-symbolic-core",
      "role": "cpu-core",
      "installKind": "python-packages",
      "stack": "python",
      "installOrder": 9,
